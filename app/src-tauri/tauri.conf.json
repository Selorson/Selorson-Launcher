{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selorson Launcher",
  "version": "0.1.1",
  "identifier": "vn.selorson.launcher",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5195",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Selorson Launcher — Trung Tâm Điều Phối Hệ Sinh Thái",
        "width": 1440,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0E1B1D"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzQjlCQTcwMUVENkI0RjAKUldUd3ROWWVjTHE1SXlud1RQTm93eEFhQW5RVWErMlAyMVZmNlRUeE1QUXdXdzZQYjhnazZLWkcK",
      "endpoints": [
        "https://github.com/Selorson/Selorson-Launcher-Release/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "resources": [
      "../../ecosystem-manifest.json",
      "../../ecosystem-manifest.schema.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "shortDescription": "Selorson Launcher — Trung tâm điều phối 1 chạm toàn bộ Hệ sinh thái Sáng tác Selorson"
  }
}
